---
layout: null
permalink: /feed.json
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "home_page_url": {{ '/' | absolute_url | jsonify }},
  "feed_url": {{ '/feed.json' | absolute_url | jsonify }},
  "language": {{ site.lang | jsonify }},
  "items": [
    {%- for g in site.posts limit: 30 %}
    {
      "id": {{ g.url | absolute_url | jsonify }},
      "url": {{ g.url | absolute_url | jsonify }},
      {%- if g.tur != "not" %}
      "title": {{ g.title | jsonify }},
      {%- endif %}
      "content_html": {{ g.content | jsonify }},
      "date_published": {{ g.date | date_to_xmlschema | jsonify }},
      "authors": [{ "name": {{ g.author | default: site.author | jsonify }} }],
      "tags": {{ g.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
